{
  "name": "quota-widget",
  "version": "0.15.1",
  "description": "Always-on-top Windows widget that tracks your AI usage quotas across providers, with reset countdowns",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:e2e": "node --test e2e/electron.e2e.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1"
  },
  "build": {
    "appId": "com.beamglyph.quotawidget",
    "productName": "Quota Widget",
    "compression": "maximum",
    "electronLanguages": [
      "de",
      "en-US",
      "es",
      "ja",
      "pt-BR",
      "zh-CN"
    ],
    "files": [
      "main.js",
      "app-data.js",
      "update.js",
      "providers/**",
      "preload.js",
      "renderer/**",
      "locales/**"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "differentialPackage": false,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quota Widget",
      "runAfterFinish": true,
      "artifactName": "Quota-Widget-Setup-${version}.${ext}"
    }
  },
  "author": {
    "name": "BeamGlyph",
    "url": "https://www.beamglyph.com"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://github.com/edilsondjr/ai-quota-widget",
  "license": "MIT",
  "keywords": [
    "widget",
    "windows",
    "electron",
    "quota",
    "usage",
    "ai",
    "llm",
    "rate-limit",
    "claude",
    "chatgpt",
    "codex",
    "ollama"
  ],
  "dependencies": {
    "jsep": "^1.6.0"
  }
}
